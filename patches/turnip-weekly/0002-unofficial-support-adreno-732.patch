From 6d07f2ee0ecdbf918fbd55074eca9cf58357c466 Mon Sep 17 00:00:00 2001
From: SansNope <nanominer20@gmail.com>
Date: Sun, 26 Jul 2026 15:17:03 +0800
Subject: freedreno/common: add unofficial support for Adreno 732

This patch is from SansNope's repo: https://github.com/SansNope/UnleashedRecomp-Android/blob/57bbe855e4abcb9849df4543d7350829fc86ca0e/turnip-driver-ci/patches-unleashed/0004-a732-bringup-ids.patch
---
 src/freedreno/common/freedreno_devices.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/freedreno/common/freedreno_devices.py b/src/freedreno/common/freedreno_devices.py
index 29364a412ca3..de990d20ca29 100644
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -1169,6 +1169,9 @@ add_gpus([
 add_gpus([
         GPUId(chip_id=0xffff43030c00, name="Adreno X1-45"),
         GPUId(chip_id=0x43030B00, name="FD735"),
+        GPUId(chip_id=0xffff43030b00, name="FD735"), # any-speedbin fallback
+        GPUId(chip_id=0x43030a00, name="FD732"), # speculative a732 own id (covers a732 = binned a735 theory)
+        GPUId(chip_id=0xffff43030a00, name="FD732"), # speculative a732 any-speedbin
         GPUId(chip_id=0xffff43030E01, name="Adreno (TM) 735"),
     ], A6xxGPUInfo(
         CHIP.A7XX,
