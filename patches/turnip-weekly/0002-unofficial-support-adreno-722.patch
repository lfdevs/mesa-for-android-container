From 7ee2f9ad6e8b980f30324d00619983a3d5c0c190 Mon Sep 17 00:00:00 2001
From: Vauzi Tri <vauzitriutomo5@gmail.com>
Date: Tue, 12 May 2026 15:36:22 +0800
Subject: [PATCH] freedreno/common: add unofficial support for Adreno 722

Created by, or sourced from, Vauzi-17
https://github.com/Vauzi-17/710/commit/df5319f68ee857c598fffd18012d066c91ed5c08
---
 src/freedreno/common/freedreno_devices.py | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/src/freedreno/common/freedreno_devices.py b/src/freedreno/common/freedreno_devices.py
index 06dc834e242..ad704e6a085 100644
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -1034,6 +1034,26 @@ add_gpus([
         raw_magic_regs = a730_raw_magic_regs,
     ))
 
+add_gpus([
+        GPUId(chip_id=0x43020100, name="FD722"),
+        GPUId(chip_id=0xffff43020100, name="FD722"),
+    ], A6xxGPUInfo(
+        CHIP.A7XX,
+        [a7xx_base, a7xx_gen1],
+        num_ccu = 3,
+        tile_align_w = 64,
+        tile_align_h = 32,
+        tile_max_w = 1024,
+        tile_max_h = 1024,
+        num_vsc_pipes = 32,
+        cs_shared_mem_size = 32 * 1024,
+        wave_granularity = 2,
+        fibers_per_sp = 128 * 2 * 16,
+        highest_bank_bit = 16,
+        magic_regs = a730_magic_regs,
+        raw_magic_regs = a730_raw_magic_regs,
+    ))
+
 add_gpus([
         GPUId(chip_id=0xffff43030c00, name="Adreno X1-45"),
         GPUId(chip_id=0x43030B00, name="FD735")
-- 
2.47.3

